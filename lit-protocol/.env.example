# Pinata IPFS API キー
# https://www.pinata.cloud/ でアカウントを作成して取得
PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET_KEY=your_pinata_secret_key_here

# Sui RPC エンドポイント
# testnet (デフォルト)
SUI_RPC_URL=https://fullnode.testnet.sui.io:443
# mainnet
# SUI_RPC_URL=https://fullnode.mainnet.sui.io:443

# Lit Protocol ネットワーク
# datil-test (デフォルト)
LIT_NETWORK=datil-test
# datil (production)
# LIT_NETWORK=datil

# 必要な SUI 残高 (MIST 単位)
# 0.1 SUI = 100,000,000 MIST
REQUIRED_BALANCE_MIST=100000000
